---
interface FooterLink {
  href: string;
  label: string;
}
interface Props {
  owner: string;
  links?: FooterLink[];
}
const { owner, links = [] } = Astro.props;
---
<footer style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding: 24px 0 40px; border-top: 1px solid var(--ink); font-family: var(--font-mono); font-size: var(--fs-11); color: var(--gray-dark); text-transform: uppercase; letter-spacing: var(--ls-5);">
  <div>© {owner}</div>
  {links.length > 0 && (
    <div style="display: flex; gap: var(--space-24);">
      {links.map((link) => (
        <a href={link.href} style="display: inline-block; padding: 14px 2px; margin: -14px -2px;">{link.label}</a>
      ))}
    </div>
  )}
</footer>
