---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PillTag from './PillTag.astro';

interface Props {
  href: string;
  context: string;
  headline: string;
  impact: string;
  stats: { label: string; value: string }[];
  image: ImageMetadata;
  imageAlt: string;
  tags: string[];
}
const { href, context, headline, impact, stats, image, imageAlt, tags } = Astro.props;
---
<a href={href} class="pg-card cs-card" style="display: flex; gap: var(--space-40); background: var(--surface-card); border-radius: var(--radius-lg); padding: var(--space-40); text-decoration: none; color: var(--ink);">
  <div class="cs-card-copy" style="flex: 1 1 55%; display: flex; flex-direction: column; gap: var(--space-16); min-width: 0;">
    <div style="font-family: var(--font-mono); font-size: var(--fs-12); color: var(--gray);">{context}</div>
    <div style="font-family: var(--font-mono); font-weight: var(--fw-bold); font-size: var(--fs-27); line-height: 1.25;">{headline}</div>
    <div>
      <div style="font-family: var(--font-mono); font-size: var(--fs-10); color: var(--gray-mid); text-transform: uppercase; letter-spacing: var(--ls-8); margin-bottom: 6px;">Impact</div>
      <div style="font-size: var(--fs-14); line-height: 1.6; color: var(--ink-mid);">{impact}</div>
    </div>
    <div style="display: flex; gap: var(--space-8); flex-wrap: wrap;">
      {tags.map((tag) => (
        <PillTag variant="outline">{tag}</PillTag>
      ))}
    </div>
    <div style="font-family: var(--font-mono); font-size: var(--fs-12); font-weight: var(--fw-medium); letter-spacing: var(--ls-4); text-transform: uppercase; color: var(--accent-solid); margin-top: auto;">Read more →</div>
  </div>
  <div class="cs-card-media" style="flex: 1 1 45%; display: flex; flex-direction: column; gap: var(--space-14); min-width: 0;">
    <div style="flex-grow: 1; min-height: 220px; border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-subtle);">
      <Image src={image} alt={imageAlt} style="width: 100%; height: 100%; object-fit: cover; display: block;" />
    </div>
  </div>
</a>

<style>
  @media (max-width: 900px) {
    .cs-card { flex-direction: column; }
    .cs-card-copy, .cs-card-media { flex: 1 1 auto; }
  }
  @media (max-width: 480px) {
    .cs-card { padding: var(--space-24) !important; gap: var(--space-24) !important; }
  }
</style>
