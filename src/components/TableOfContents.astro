---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---
{items.length > 0 && (
  <nav class="pg-toc" aria-label="Table of contents">
    <div class="pg-toc-label">On this page</div>
    <ol class="pg-toc-list">
      {items.map((item, i) => (
        <li><a href={`#${item.slug}`}><span class="pg-toc-num">{String(i + 1).padStart(2, '0')}</span>{item.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .pg-toc { background: var(--bg-subtle); border-radius: var(--radius-lg); padding: var(--pad-panel-alt); margin: 8px 0 44px; }
  .pg-toc-label { font-family: var(--font-mono); font-size: var(--fs-12); letter-spacing: var(--ls-10); text-transform: uppercase; color: var(--accent-solid); font-weight: var(--fw-medium); margin: 0 0 16px; }
  .pg-toc-list { list-style: none; margin: 0; padding: 0; column-count: 2; column-width: 200px; column-gap: var(--space-24); }
  .pg-toc-list li { break-inside: avoid; margin-bottom: 10px; }
  .pg-toc-list a { display: flex; align-items: baseline; gap: 10px; font-family: var(--font-mono); font-size: var(--fs-14); }
  .pg-toc-num { color: var(--accent); font-weight: var(--fw-bold); font-size: var(--fs-12); flex: 0 0 auto; }
  @media (max-width: 700px) {
    .pg-toc-list { column-count: 1; }
  }
</style>
